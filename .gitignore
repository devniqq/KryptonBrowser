document.addEventListener('DOMContentLoaded', () => {
  const buttons = document.querySelectorAll('.primary-btn, .secondary-btn, .nav-button');

  buttons.forEach((button) => {
    button.addEventListener('mouseenter', () => {
      button.style.filter = 'brightness(1.04)';
    });

    button.addEventListener('mouseleave', () => {
      button.style.filter = 'none';
    });
  });

  const cards = document.querySelectorAll('.feature-card, .compare-card, .download-card, .security-card');
  cards.forEach((card) => {
    card.addEventListener('mouseenter', () => {
      card.style.borderColor = 'rgba(103, 164, 255, 0.35)';
      card.style.boxShadow = '0 18px 38px rgba(9, 17, 28, 0.42)';
    });

    card.addEventListener('mouseleave', () => {
      card.style.borderColor = 'rgba(145, 173, 218, 0.18)';
      card.style.boxShadow = 'none';
    });
  });
});
